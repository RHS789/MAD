<?xml version="1.0" encoding="utf-8"?> 
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" 
    xmlns:app="http://schemas.android.com/apk/res-auto" 
    xmlns:tools="http://schemas.android.com/tools" 
    android:layout_width="match_parent" 
    android:layout_height="match_parent" 
    android:padding="10dp" 
    tools:context=".LoginActivity"> 
    <EditText 
        android:id="@+id/u1" 
        android:layout_width="match_parent"         android:layout_height="wrap_content"         android:hint="User Name" 
        android:layout_marginTop="50dp"/> 
    <EditText 
        android:id="@+id/p1" 
        android:layout_width="match_parent"         android:layout_height="wrap_content"         android:hint="Password" 
        android:layout_marginTop="50dp" 
        android:layout_below="@+id/u1"/> 
    <Button 
        android:id="@+id/b" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:text="Sign in" 
        android:layout_marginTop="50dp" 
        android:layout_below="@+id/p1"/> </RelativeLayout> 
